# The Docker network of your MailFlow stack: "docker network ls | grep mailflow".
MAILFLOW_NETWORK=mailflow_mailflow

# MailFlow's backend as seen from that network.
MAILFLOW_URL=http://mailflow-backend:3000

# Where the bridge is published on the host. Keep 127.0.0.1 and put an HTTPS reverse proxy in front.
MCP_BIND=127.0.0.1
MCP_PORT=3100

# Optional single-user mode for assistants that cannot send an Authorization header:
# the bridge then answers on /mcp/<MCP_URL_SECRET> with this one token. Whoever knows that
# URL can read this user's mail, so treat the URL like a password.
# MCP_URL_SECRET: openssl rand -hex 32
MAILFLOW_API_TOKEN=
MCP_URL_SECRET=
